{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["../scripts/*"]
    }
  },
  "include": [
    "src",
    "vite.config.ts",
    "../scripts/config/podcast-shows.ts",
    "../scripts/config/default-settings.ts",
    "../scripts/types/index.ts"
  ]
}
